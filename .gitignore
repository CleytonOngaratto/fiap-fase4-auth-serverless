# Estado do Terraform — NUNCA versionar (contém tudo em texto plano).
*.tfstate
*.tfstate.*

# Diretório de trabalho / providers baixados.
.terraform/

# Config do backend: depende da conta do Learner Lab (gerada por bootstrap-backend.ps1 no repo de plataforma).
backend.hcl

# Valores locais. O terraform.tfvars.example É versionado (não casa este padrão) e serve de molde.
terraform.tfvars
*.auto.tfvars

# Planos salvos e crash logs.
*.tfplan
tfplan
crash.log
crash.*.log

# O .terraform.lock.hcl NÃO entra aqui de propósito: ele é versionado para o CI resolver
# exatamente os mesmos providers que a máquina local.

# ==========================================
# IDE — configuração de máquina, não de projeto
# ==========================================
.idea
*.iml
.vscode

# ==========================================
# Lambda Node.js
# ==========================================
node_modules/
*.zip
builds/

# Chaves e credenciais. A chave RSA vive no SSM (SecureString) e é lida em runtime pela função;
# PEM em disco é só conveniência de desenvolvimento.
*.pem
.secrets/
.aws/
.env

# ==========================================
# IA / cockpit (moram na pasta-mãe, não neste repo)
# ==========================================
CLAUDE.md
.claude/
PLAN-FASE4.md
PROGRESS-FASE4.md
